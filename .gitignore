# ============================================
# SICAWN — .gitignore (PHP / MySQL / XAMPP)
# ============================================

# --- Credenciales y configuración sensible ---
config/conexion.php
config/*.local.php
.env
.env.*
!.env.example

# --- Dumps de base de datos con datos reales ---
database/*.sql.bak
database/backups/
database/dump_*.sql
*.sql.gz
!database/schema.sql
!database/seed.sql

# --- Comprobantes/PDFs generados por el sistema (datos reales de pagos) ---
storage/comprobantes/*.pdf
storage/reportes/*.pdf
storage/respaldos/

# --- Archivos de sistema operativo ---
.DS_Store
Thumbs.db
desktop.ini

# --- XAMPP / logs locales ---
*.log
error_log
access_log

# --- Editor / VSCode ---
.vscode/*
!.vscode/tasks.json
!.vscode/settings.json
*.code-workspace

# --- Composer (si llegan a usarlo más adelante) ---
vendor/
composer.lock

# --- Archivos temporales ---
*.tmp
*.bak
~$*